    },
    "peerDependencies": {
        "vite": "*",
        "@compiled/react": "*",
        "@vitejs/plugin-react": "*"
    },
    "devDependencies": {
        "@compiled/react": "^0.18.3",
        "@types/babel__core": "7.20.5",
        "@types/node": "^22.14.0",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "@types/react": "^19.1.0",
        "@vitejs/plugin-react": "^4.3.4"
    },
    "prettier": {
        "singleQuote": true,
        "arrowParens": "avoid"
    },

    "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
